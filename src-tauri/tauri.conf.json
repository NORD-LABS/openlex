{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenLex",
  "version": "0.2.0",
  "identifier": "ca.nordlabs.openlex",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenLex",
        "width": 400,
        "height": 640,
        "minWidth": 340,
        "minHeight": 420,
        "alwaysOnTop": true
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "OpenLex — suggestions",
        "width": 760,
        "height": 76,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focusable": false,
        "focus": false,
        "visible": false,
        "resizable": false,
        "shadow": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Aide libre à la lecture et à l'écriture",
    "longDescription": "OpenLex aide les élèves dyslexiques et dysorthographiques : prédiction phonétique et synthèse vocale, 100 % hors ligne.",
    "category": "Education",
    "publisher": "NORD LABS",
    "copyright": "© 2026 NORD LABS — GPL-3.0"
  }
}